# Copy to .env and fill your own local 9router key.
AUTO_TRANSLATE_NINEROUTER_API_URL=http://127.0.0.1:20128/v1
AUTO_TRANSLATE_NINEROUTER_API_KEY=
AUTO_TRANSLATE_AI_MODEL=ag/gemini-3.8-flash-medium
AUTO_TRANSLATE_TRANSLATION_ENGINE=gemini
AUTO_TRANSLATE_AI_ENGINE=passthrough
AUTO_TRANSLATE_VOICE_ENGINE=disabled
AUTO_TRANSLATE_TARGET_LANGUAGE=vi
AUTO_TRANSLATE_WHISPER_MODEL=base
AUTO_TRANSLATE_WHISPER_DEVICE=cpu
AUTO_TRANSLATE_WHISPER_COMPUTE_TYPE=int8
AUTO_TRANSLATE_VIDEO_ENCODER=libx264
AUTO_TRANSLATE_DOUYIN_DOWNLOADER_TOOL_ENABLED=false
AUTO_TRANSLATE_CORS_ORIGINS=["http://127.0.0.1:5175","http://localhost:5175"]
